# MID360 ACX750 上位机环境变量。
# 安装脚本会把它复制到 /etc/mid360/host.env，由 systemd 的 EnvironmentFile 读取。
# 请按现场实际路径修改下列值。

# 源码 checkout 根目录（与仓库根一致）
MID360_REPO=/opt/mid360_pc_fpga

# systemd 直接执行的启动脚本路径
MID360_START=/opt/mid360_pc_fpga/fpga_acx750/deploy/start_host.sh

# Python 解释器；如果使用了虚拟环境，改成对应 venv 里的 python
MID360_PYTHON=/usr/bin/python3

# UDP 监听：接收 PL 发来的 M3TL 遥测
MID360_HOST_BIND=0.0.0.0
MID360_HOST_PORT=46000

# 本地网页服务（浏览器访问 http://<树莓派IP>:8765/）
MID360_HOST_WEB_BIND=0.0.0.0
MID360_HOST_WEB_PORT=8765

# 会话落盘根目录；留空 MID360_SESSION 表示只接收不落盘
MID360_SESSION_DIR=/var/lib/mid360-host/sessions
MID360_SESSION=

# 可选：改用 JSON 配置文件时填写其路径，命令行参数优先级更高
MID360_CONFIG=