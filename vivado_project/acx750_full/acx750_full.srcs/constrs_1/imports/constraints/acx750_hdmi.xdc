# ACX750_CB_PIN.xdc and vendor ch26: board HDMI output, TMDS_33.
set_property PACKAGE_PIN J19 [get_ports hdmi_clk_p]
set_property PACKAGE_PIN H19 [get_ports hdmi_clk_n]
set_property PACKAGE_PIN K21 [get_ports {hdmi_dat_p[0]}]
set_property PACKAGE_PIN K22 [get_ports {hdmi_dat_n[0]}]
set_property PACKAGE_PIN J20 [get_ports {hdmi_dat_p[1]}]
set_property PACKAGE_PIN J21 [get_ports {hdmi_dat_n[1]}]
set_property PACKAGE_PIN J22 [get_ports {hdmi_dat_p[2]}]
set_property PACKAGE_PIN H22 [get_ports {hdmi_dat_n[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_clk_p hdmi_clk_n hdmi_dat_p[*] hdmi_dat_n[*]}]
set_property PACKAGE_PIN M22 [get_ports hdmi_oe]
set_property IOSTANDARD LVCMOS33 [get_ports hdmi_oe]
# S0 D21 is the existing btn_reset_n. These are S1,S2,S3,S4.
set_property PACKAGE_PIN E21 [get_ports {buttons_n[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {buttons_n[0]}]
set_property PULLUP true [get_ports {buttons_n[0]}]
set_property PACKAGE_PIN G22 [get_ports {buttons_n[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {buttons_n[1]}]
set_property PULLUP true [get_ports {buttons_n[1]}]
set_property PACKAGE_PIN G21 [get_ports {buttons_n[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {buttons_n[2]}]
set_property PULLUP true [get_ports {buttons_n[2]}]
set_property PACKAGE_PIN B22 [get_ports {buttons_n[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {buttons_n[3]}]
set_property PULLUP true [get_ports {buttons_n[3]}]
