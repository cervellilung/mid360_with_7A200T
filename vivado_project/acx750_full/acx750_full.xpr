        <Step Id="post_place_power_opt_design"/>
        <Step Id="phys_opt_design" PostStepTclHook="$PPRDIR/../../tools/scripts/hooks/report_phys_opt_design.tcl">
          <Option Id="Directive">2</Option>
        </Step>
        <Step Id="route_design" PostStepTclHook="$PPRDIR/../../tools/scripts/hooks/report_route_design.tcl">
          <Option Id="MoreOptsStr"><![CDATA[-tns_cleanup]]></Option>
        </Step>
        <Step Id="post_route_phys_opt_design">
          <Option Id="Directive">1</Option>
        </Step>
        <Step Id="write_bitstream"/>
      </Strategy>
      <GeneratedRun Dir="$PRUNDIR" File="gen_run.xml"/>
      <ReportStrategy Name="Vivado Implementation Default Reports" Flow="Vivado Implementation 2020"/>
      <Report Name="ROUTE_DESIGN.REPORT_METHODOLOGY" Enabled="1"/>
      <RQSFiles/>
    </Run>
